generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  PASSWORD_EXPIRED
  LOCKED
  BLOCKED
  DISABLED
}

enum PermissionEffect {
  ALLOW
  DENY
}



enum BusinessPartnerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BusinessPartnerRole {
  CUSTOMER
  SUPPLIER
  CARRIER
  SALES_REP
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryControl {
  NONE
  SIMPLE
  BATCH
  SERIAL
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER
}

model Company {
  id String @id @default(cuid())

  code String @unique @db.VarChar(20)

  legalName String @db.VarChar(200)

  tradeName String? @db.VarChar(200)

  document String @unique @db.VarChar(20)

  stateRegistration String? @db.VarChar(30)

  municipalRegistration String? @db.VarChar(30)

  email String? @db.VarChar(150)

  phone String? @db.VarChar(30)

  mobile String? @db.VarChar(30)

  website String? @db.VarChar(200)

  logo String? @db.VarChar(255)

  timezone String @default("America/Sao_Paulo") @db.VarChar(60)

  language String @default("pt-BR") @db.VarChar(10)

  currency String @default("BRL") @db.VarChar(10)

  active Boolean @default(true)

  users User[]

  roles Role[]

  partners BusinessPartner[]

  productCategories ProductCategory[]

  brands Brand[]

  units UnitOfMeasure[]

  products Product[]

  companyPlan CompanyPlan?

  companyModules CompanyModule[]

  licenseHistory LicenseHistory[]

  createdAt DateTime @default(now())

  updatedAt      DateTime        @updatedAt
  warehouses     Warehouse[]
  inventories    Inventory[]
  stockMovements StockMovement[]

  deletedAt DateTime?
  purchases Purchase[]
  sales     Sale[]


  @@map("companies")
}


model BusinessPartner {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Papéis do parceiro. Um mesmo cadastro pode ser cliente e
  /// fornecedor ao mesmo tempo. Deve conter ao menos um item
  /// (validado na camada de serviço).
  roles BusinessPartnerRole[]

  personType PersonType @default(COMPANY)

  /// Razão social (PJ) ou nome completo (PF)
  legalName String @db.VarChar(200)

  /// Nome fantasia (PJ) ou apelido (PF)
  tradeName String? @db.VarChar(200)

  /// CNPJ ou CPF — único por empresa
  document String @db.VarChar(20)

  /// Inscrição estadual (PJ) ou RG (PF)
  stateRegistration String? @db.VarChar(30)

  email String? @db.VarChar(150)

  phone String? @db.VarChar(30)

  mobile String? @db.VarChar(30)

  contactName String? @db.VarChar(150)

  zipCode String? @db.VarChar(15)

  street String? @db.VarChar(150)

  number String? @db.VarChar(20)

  complement String? @db.VarChar(100)

  district String? @db.VarChar(100)

  city String? @db.VarChar(100)

  state String? @db.VarChar(2)

  notes String? @db.Text

  status BusinessPartnerStatus @default(ACTIVE)

  active Boolean @default(true)

  sales Sale[] @relation("SalePartner")

  purchases Purchase[] @relation("PurchasePartner")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([companyId, document])
  @@index([companyId])
  @@index([legalName])
  @@index([document])
  @@index([status])
  @@map("business_partners")
}

model User {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name String @db.VarChar(150)

  email String @unique @db.VarChar(150)

  passwordHash String @db.VarChar(255)

  status UserStatus @default(PENDING_ACTIVATION)

  mustChangePassword Boolean @default(true)

  passwordChangedAt DateTime?

  lastLoginAt DateTime?

  lastLoginIp String? @db.VarChar(45)

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  refreshTokenHash String? @db.VarChar(255)

  active Boolean @default(true)

  roles UserRole[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("users")
}

model Role {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  code String @db.VarChar(100)

  description String? @db.VarChar(255)

  isSystem Boolean @default(false)

  active Boolean @default(true)

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model PermissionGroup {
  id String @id @default(cuid())

  name String @unique @db.VarChar(100)

  code String @unique @db.VarChar(100)

  description String? @db.VarChar(255)

  permissions Permission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("permission_groups")
}

model Permission {
  id String @id @default(cuid())

  groupId String

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String @db.VarChar(150)

  code String @unique @db.VarChar(150)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(cuid())

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  effect PermissionEffect @default(ALLOW)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id String @id @default(cuid())

  userId String

  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}


model ProductCategory {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(255)
  active      Boolean     @default(true)
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(120)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model UnitOfMeasure {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String    @db.VarChar(10)
  description String    @db.VarChar(80)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units")
}

model Product {
  id                       String           @id @default(cuid())
  companyId                String
  company                  Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId               String?
  category                 ProductCategory? @relation(fields: [categoryId], references: [id])
  brandId                  String?
  brand                    Brand?           @relation(fields: [brandId], references: [id])
  unitId                   String
  unit                     UnitOfMeasure    @relation(fields: [unitId], references: [id])
  code                     String           @db.VarChar(30)
  barcode                  String?          @db.VarChar(30)
  description              String           @db.VarChar(200)
  complementaryDescription String?          @db.VarChar(255)
  type                     ProductType      @default(PRODUCT)
  inventoryControl         InventoryControl @default(SIMPLE)
  cost                     Decimal          @db.Decimal(18, 2)
  salePrice                Decimal          @db.Decimal(18, 2)
  minimumStock             Decimal          @default(0) @db.Decimal(18, 3)
  currentStock             Decimal          @default(0) @db.Decimal(18, 3)
  status                   ProductStatus    @default(ACTIVE)
  active                   Boolean          @default(true)
  createdAt                DateTime         @default(now())
  updatedAt                DateTime         @updatedAt
  deletedAt                DateTime?
  Inventory                Inventory[]
  purchaseItems            PurchaseItem[]
  saleItems                SaleItem[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("products")
}

model Warehouse {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String      @db.VarChar(20)
  description String      @db.VarChar(120)
  active      Boolean     @default(true)
  inventories Inventory[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  purchases   Purchase[]
  sales       Sale[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model Inventory {
  id                String           @id @default(cuid())
  companyId         String
  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId         String
  product           Product          @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId       String
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity          Decimal          @default(0) @db.Decimal(18, 4)
  averageCost       Decimal          @default(0) @db.Decimal(18, 4)
  active            Boolean          @default(true)
  movements         StockMovement[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ProductCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  productCategoryId String?

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventories")
}

model StockMovement {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 4)
  unitCost    Decimal?          @db.Decimal(18, 4)
  observation String?           @db.VarChar(255)
  createdAt   DateTime          @default(now())

  @@index([companyId])
  @@index([inventoryId])
  @@map("stock_movements")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  APPROVED
  INVOICED
  SHIPPED
  CANCELLED
}

model Purchase {
  id           String         @id @default(cuid())
  companyId    String
  company      Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId    String
  partner      BusinessPartner @relation("PurchasePartner", fields: [partnerId], references: [id])
  warehouseId  String
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  status       PurchaseStatus @default(DRAFT)
  purchaseDate DateTime?
  observation  String?
  totalAmount  Decimal        @default(0) @db.Decimal(18, 2)
  items        PurchaseItem[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(18, 3)
  unitPrice  Decimal  @db.Decimal(18, 2)
  totalPrice Decimal  @db.Decimal(18, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

model Sale {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  partnerId   String
  partner     BusinessPartner @relation("SalePartner", fields: [partnerId], references: [id])
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status SaleStatus @default(DRAFT)

  saleDate DateTime?

  approvedAt  DateTime?
  invoicedAt  DateTime?
  shippedAt   DateTime?
  cancelledAt DateTime?

  invoiceNumber String? @db.VarChar(50)
  trackingCode  String? @db.VarChar(100)

  observation String?

  discountValue Decimal @default(0) @db.Decimal(18, 2)
  freightValue  Decimal @default(0) @db.Decimal(18, 2)
  otherExpenses Decimal @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)

  items SaleItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(18, 3)
  unitPrice  Decimal @db.Decimal(18, 2)
  totalPrice Decimal @db.Decimal(18, 2)

  @@index([saleId])
  @@map("sale_items")
}

model Module {
  id             String           @id @default(cuid())
  code           String           @unique @db.VarChar(50)
  name           String           @db.VarChar(150)
  description    String?          @db.VarChar(500)
  icon           String?          @db.VarChar(100)
  route          String?          @db.VarChar(150)
  sortOrder      Int              @default(0)
  active         Boolean          @default(true)
  planModules    PlanModule[]
  companyModules CompanyModule[]
  licenseHistory LicenseHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("modules")
}

model Plan {
  id             String           @id @default(cuid())
  code           String           @unique @db.VarChar(50)
  name           String           @db.VarChar(150)
  description    String?          @db.VarChar(500)
  monthlyPrice   Decimal?         @db.Decimal(18, 2)
  yearlyPrice    Decimal?         @db.Decimal(18, 2)
  maxUsers       Int?
  active         Boolean          @default(true)
  planModules    PlanModule[]
  companyPlans   CompanyPlan[]
  licenseHistory LicenseHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("plans")
}

model PlanModule {
  id        String   @id @default(cuid())
  planId    String
  moduleId  String
  included  Boolean  @default(true)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("plan_modules")
}

model CompanyPlan {
  id          String    @id @default(cuid())
  companyId   String    @unique
  planId      String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  trialEndsAt DateTime?
  active      Boolean   @default(true)
  autoRenew   Boolean   @default(true)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([planId])
  @@map("company_plans")
}

model CompanyModule {
  id            String    @id @default(cuid())
  companyId     String
  moduleId      String
  enabled       Boolean   @default(true)
  licensed      Boolean   @default(true)
  trial         Boolean   @default(false)
  trialStartsAt DateTime?
  trialEndsAt   DateTime?
  activatedAt   DateTime?
  expiresAt     DateTime?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module        Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

model LicenseHistory {
  id          String   @id @default(cuid())
  companyId   String
  moduleId    String?
  planId      String?
  event       String   @db.VarChar(50)
  description String?  @db.VarChar(500)
  createdBy   String?
  metadata    Json?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([moduleId])
  @@index([planId])
  @@map("license_history")
}
