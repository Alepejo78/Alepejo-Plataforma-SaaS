generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING_ACTIVATION
  ACTIVE
  PASSWORD_EXPIRED
  LOCKED
  BLOCKED
  DISABLED
}

enum PermissionEffect {
  ALLOW
  DENY
}

enum BusinessPartnerStatus {
  ACTIVE
  INACTIVE
  BLOCKED
}

enum BusinessPartnerRole {
  CUSTOMER
  SUPPLIER
  CARRIER
  SALES_REP
}

enum PersonType {
  INDIVIDUAL
  COMPANY
}

enum ProductType {
  PRODUCT
  SERVICE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum InventoryControl {
  NONE
  SIMPLE
  BATCH
  SERIAL
}

enum StockMovementType {
  ENTRY
  EXIT
  ADJUSTMENT
  TRANSFER
  /// Registro de bloqueio/reserva/quarentena/avaria (StockHold criado).
  HOLD
  /// Registro de liberação de um StockHold.
  RELEASE
}

model Company {
  id String @id @default(cuid())

  code String @unique @db.VarChar(20)

  /// URL amigável ("minha-empresa") — usada no link fixo de login
  /// (`/<slug>/login`), gerada a partir do nome no cadastro.
  slug String @unique @db.VarChar(80)

  legalName String @db.VarChar(200)

  tradeName String? @db.VarChar(200)

  document String @unique @db.VarChar(20)

  stateRegistration String? @db.VarChar(30)

  municipalRegistration String? @db.VarChar(30)

  email String? @db.VarChar(150)

  phone String? @db.VarChar(30)

  mobile String? @db.VarChar(30)

  website String? @db.VarChar(200)

  /// Endereço — mesmo conjunto de campos já usado em Employee.
  zipCode  String? @db.VarChar(10)
  street   String? @db.VarChar(200)
  number   String? @db.VarChar(20)
  district String? @db.VarChar(100)
  city     String? @db.VarChar(100)
  state    String? @db.VarChar(2)

  /// Logo para o tema claro. Padrão do sistema se vazio.
  logo String? @db.VarChar(255)

  /// Logo para o tema escuro (módulo BRANDING). Sem ela, usa `logo` também no escuro.
  logoDark String? @db.VarChar(255)

  /// Nome exibido no lugar de "AlePejo ERP Cloud" (módulo BRANDING).
  systemName String? @db.VarChar(150)

  /// Chaves liga/desliga do módulo BRANDING — cada uma independente:
  /// desligada, usa o padrão AlePejo naquele item mesmo que exista
  /// arquivo/nome salvo (permite deixar algo pronto sem publicar).
  brandingLogoLightEnabled   Boolean @default(false)
  brandingLogoDarkEnabled    Boolean @default(false)
  brandingLoginVideoEnabled  Boolean @default(false)
  brandingSystemNameEnabled  Boolean @default(false)
  brandingThemeToggleEnabled Boolean @default(false)

  /// Layout do menu: "vertical" (sidebar lateral) ou "horizontal"
  /// (barra tipo ribbon no topo). Módulo BRANDING.
  sidebarLayout String @default("vertical") @db.VarChar(10)

  timezone String @default("America/Sao_Paulo") @db.VarChar(60)

  language String @default("pt-BR") @db.VarChar(10)

  currency String @default("BRL") @db.VarChar(10)

  active Boolean @default(true)

  users User[]

  roles Role[]

  partners BusinessPartner[]

  productCategories ProductCategory[]

  brands Brand[]

  units UnitOfMeasure[]

  products Product[]

  companyPlan CompanyPlan?

  companyModules CompanyModule[]

  licenseHistory LicenseHistory[]

  createdAt DateTime @default(now())

  updatedAt      DateTime        @updatedAt
  warehouses     Warehouse[]
  inventories    Inventory[]
  stockMovements StockMovement[]
  stockHolds     StockHold[]

  deletedAt DateTime?
  purchases Purchase[]
  sales     Sale[]

  chartOfAccounts               ChartOfAccount[]
  chartOfAccountClassifications ChartOfAccountClassification[]
  financialEntries              FinancialEntry[]
  budgets                       Budget[]
  payrollTaxTables              PayrollTaxTable[]
  payrollSettings               PayrollSettings?
  payrolls                      Payroll[]
  thirteenthSalaries            ThirteenthSalary[]
  vacationPeriods               VacationPeriod[]
  vacationGrants                VacationGrant[]

  quotes            Quote[]
  salesOrders       SalesOrder[]
  quotations        Quotation[]
  purchaseOrders    PurchaseOrder[]
  documentSequences DocumentSequence[]

  sectors            Sector[]
  jobFunctions       JobFunction[]
  workSchedules      WorkSchedule[]
  workScheduleShifts WorkScheduleShift[]
  ppeTypes           PpeType[]
  employees          Employee[]
  ppeDeliveries      PpeDelivery[]
  benefits           Benefit[]

  productionOrders   ProductionOrder[]
  productionSettings ProductionSettings?

  timeEntries          TimeEntry[]
  timeSheetApprovals   TimeSheetApproval[]
  timeEntryAdjustments TimeEntryAdjustment[]
  absenceRecords       AbsenceRecord[]

  /// Chave de API para dispositivos externos baterem ponto (relógio de
  /// ponto, leitor de QR/código de barras) sem login — hash (bcrypt),
  /// nunca gravamos o valor puro. Mostrado por inteiro só uma vez, na
  /// hora de gerar/regenerar (ver TimeClockApiKeyService).
  timeClockApiKeyHash      String?   @db.VarChar(255)
  timeClockApiKeyPrefix    String?   @db.VarChar(12)
  timeClockApiKeyCreatedAt DateTime?

  /// Configuração de SMTP própria da empresa, pra sair com o e-mail
  /// que o cliente quiser (avisos de cotação, redefinição de senha
  /// etc.) em vez do SMTP global do .env. Desligada (smtpEnabled
  /// false) ou sem host configurado, o sistema cai no .env como
  /// hoje — ver EmailNotificationsService.
  smtpHost              String? @db.VarChar(255)
  smtpPort              Int?
  smtpUser              String? @db.VarChar(255)
  /// Criptografada (AES-256-GCM, EncryptionService) — precisa voltar
  /// ao valor original pra autenticar no servidor SMTP, por isso não
  /// é hash. Nunca devolvida pro frontend depois de salva.
  smtpPasswordEncrypted String? @db.Text
  smtpFromEmail         String? @db.VarChar(150)
  smtpFromName          String? @db.VarChar(150)
  smtpEnabled           Boolean @default(false)

  /// Agrupa empresas do mesmo cliente (mesmo grupo/raiz de CNPJ) sob
  /// uma licença só. `null` = a própria empresa é a raiz (caso
  /// normal). Preenchido = aponta direto pra raiz de verdade, nunca
  /// encadeado pra outra filial (CompanyOnboardingService.createAdditional).
  rootCompanyId    String?
  rootCompany      Company?  @relation("CompanyGroup", fields: [rootCompanyId], references: [id])
  siblingCompanies Company[] @relation("CompanyGroup")

  /// Logins com acesso a esta empresa (login cruzado entre empresas do
  /// mesmo grupo) — ver UserCompany.
  userLinks UserCompany[]

  @@map("companies")
}

model BusinessPartner {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Papéis do parceiro. Um mesmo cadastro pode ser cliente e
  /// fornecedor ao mesmo tempo. Deve conter ao menos um item
  /// (validado na camada de serviço).
  roles BusinessPartnerRole[]

  personType PersonType @default(COMPANY)

  /// Razão social (PJ) ou nome completo (PF)
  legalName String @db.VarChar(200)

  /// Nome fantasia (PJ) ou apelido (PF)
  tradeName String? @db.VarChar(200)

  /// CNPJ ou CPF — único por empresa
  document String @db.VarChar(20)

  /// Inscrição estadual (PJ) ou RG (PF)
  stateRegistration String? @db.VarChar(30)

  email String? @db.VarChar(150)

  phone String? @db.VarChar(30)

  mobile String? @db.VarChar(30)

  contactName String? @db.VarChar(150)

  zipCode String? @db.VarChar(15)

  street String? @db.VarChar(150)

  number String? @db.VarChar(20)

  complement String? @db.VarChar(100)

  district String? @db.VarChar(100)

  city String? @db.VarChar(100)

  state String? @db.VarChar(2)

  notes String? @db.Text

  status BusinessPartnerStatus @default(ACTIVE)

  active Boolean @default(true)

  sales Sale[] @relation("SalePartner")

  purchases Purchase[] @relation("PurchasePartner")

  financialEntries FinancialEntry[] @relation("FinancialEntryPartner")

  quotes          Quote[]          @relation("QuotePartner")
  salesOrders     SalesOrder[]     @relation("SalesOrderPartner")
  quotationOffers QuotationOffer[] @relation("QuotationOfferPartner")
  purchaseOrders  PurchaseOrder[]  @relation("PurchaseOrderPartner")

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([companyId, document])
  @@index([companyId])
  @@index([legalName])
  @@index([document])
  @@index([status])
  @@map("business_partners")
}

model User {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  name String @db.VarChar(150)

  email String @unique @db.VarChar(150)

  passwordHash String @db.VarChar(255)

  status UserStatus @default(PENDING_ACTIVATION)

  mustChangePassword Boolean @default(true)

  passwordChangedAt DateTime?

  department String? @db.VarChar(150)

  /// Gerente do usuário — só informativo, não aciona fluxo nenhum.
  manager String? @db.VarChar(150)

  alias String? @db.VarChar(150)

  /// Hash do token de redefinição de senha por e-mail (bcrypt via
  /// PasswordService, mesmo padrão de passwordHash). O valor puro só
  /// existe no link enviado por e-mail, nunca é gravado.
  passwordResetTokenHash String? @db.VarChar(255)

  passwordResetTokenExpiresAt DateTime?

  lastLoginAt DateTime?

  lastLoginIp String? @db.VarChar(45)

  failedLoginAttempts Int @default(0)

  lockedUntil DateTime?

  refreshTokenHash String? @db.VarChar(255)

  active Boolean @default(true)

  /// Foto de perfil (autoatendimento, não depende de licença/módulo).
  avatar String? @db.VarChar(255)

  /// Desligada, mostra as iniciais no lugar da foto mesmo com uma já enviada.
  avatarEnabled Boolean @default(false)

  roles UserRole[]

  /// Colaborador (RH) vinculado a este login — usado por telas de
  /// autoatendimento (ex.: Ponto - Manual) pra saber "quem é o
  /// colaborador do usuário logado" sem depender de bater e-mail.
  employee Employee?

  /// Empresas que este login pode acessar (login cruzado dentro do
  /// mesmo grupo). `companyId` acima é sempre a empresa ATIVA da
  /// sessão (trocável via AuthService.switchCompany) — sempre precisa
  /// ter um UserCompany correspondente.
  companies UserCompany[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@index([companyId])
  @@index([email])
  @@index([status])
  @@map("users")
}

/// Vínculo/entitlement: quais empresas um login (User) pode acessar.
/// Escopado hoje a empresas do mesmo grupo (rootCompanyId), criado em
/// CompanyOnboardingService.createAdditional (auto-vínculo de quem
/// cadastrou) e em CompanyService.linkUserToGroupCompany (vínculo
/// manual). Cada empresa vinculada tem sua própria Role/UserRole
/// (Role é por empresa) — este model só controla a lista de empresas
/// que aparecem no seletor de "trocar de empresa".
model UserCompany {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, companyId])
  @@index([companyId])
  @@map("user_companies")
}

model Role {
  id String @id @default(cuid())

  companyId String

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  name String @db.VarChar(100)

  code String @db.VarChar(100)

  description String? @db.VarChar(255)

  isSystem Boolean @default(false)

  active Boolean @default(true)

  users UserRole[]

  permissions RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  deletedAt DateTime?

  @@unique([companyId, code])
  @@unique([companyId, name])
  @@index([companyId])
  @@map("roles")
}

model PermissionGroup {
  id String @id @default(cuid())

  name String @unique @db.VarChar(100)

  code String @unique @db.VarChar(100)

  description String? @db.VarChar(255)

  permissions Permission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@map("permission_groups")
}

model Permission {
  id String @id @default(cuid())

  groupId String

  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  name String @db.VarChar(150)

  code String @unique @db.VarChar(150)

  description String? @db.VarChar(255)

  active Boolean @default(true)

  roles RolePermission[]

  createdAt DateTime @default(now())

  updatedAt DateTime @updatedAt

  @@index([groupId])
  @@map("permissions")
}

model RolePermission {
  id String @id @default(cuid())

  roleId String

  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  effect PermissionEffect @default(ALLOW)

  createdAt DateTime @default(now())

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model UserRole {
  id String @id @default(cuid())

  userId String

  roleId String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model ProductCategory {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String      @db.VarChar(120)
  description String?     @db.VarChar(255)
  active      Boolean     @default(true)
  products    Product[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  inventories Inventory[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("product_categories")
}

model Brand {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String    @db.VarChar(120)
  active    Boolean   @default(true)
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("brands")
}

model UnitOfMeasure {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code        String    @db.VarChar(10)
  description String    @db.VarChar(80)
  active      Boolean   @default(true)
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@map("units")
}

model Product {
  id                       String               @id @default(cuid())
  companyId                String
  company                  Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  categoryId               String?
  category                 ProductCategory?     @relation(fields: [categoryId], references: [id])
  brandId                  String?
  brand                    Brand?               @relation(fields: [brandId], references: [id])
  unitId                   String
  unit                     UnitOfMeasure        @relation(fields: [unitId], references: [id])
  code                     String               @db.VarChar(30)
  barcode                  String?              @db.VarChar(30)
  reference                String?              @db.VarChar(50)
  description              String               @db.VarChar(200)
  complementaryDescription String?              @db.VarChar(255)
  type                     ProductType          @default(PRODUCT)
  inventoryControl         InventoryControl     @default(SIMPLE)
  /// Congelado (frente "Interprise") — Product virou cadastro de
  /// grupo, custo real passou a ser Inventory.averageCost (por
  /// empresa/depósito). Default só pra não quebrar create() sem o
  /// campo, não é mais preenchido pela tela.
  cost                     Decimal              @default(0) @db.Decimal(18, 2)
  salePrice                Decimal              @db.Decimal(18, 2)
  minimumStock             Decimal              @default(0) @db.Decimal(18, 3)
  currentStock             Decimal              @default(0) @db.Decimal(18, 3)
  /// Lote mínimo por ordem de produção — sobrepõe o padrão da
  /// empresa (ProductionSettings.minBatchSize) quando preenchido.
  minProductionBatch       Decimal?             @db.Decimal(18, 3)
  status                   ProductStatus        @default(ACTIVE)
  active                   Boolean              @default(true)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  deletedAt                DateTime?
  Inventory                Inventory[]
  purchaseItems            PurchaseItem[]
  saleItems                SaleItem[]
  quoteItems               QuoteItem[]
  salesOrderItems          SalesOrderItem[]
  quotationItems           QuotationItem[]
  quotationOfferItems      QuotationOfferItem[]
  purchaseOrderItems       PurchaseOrderItem[]
  productionOrders         ProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("products")
}

model Warehouse {
  id               String            @id @default(cuid())
  companyId        String
  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code             String            @db.VarChar(20)
  description      String            @db.VarChar(120)
  active           Boolean           @default(true)
  inventories      Inventory[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  purchases        Purchase[]
  quotes           Quote[]
  salesOrders      SalesOrder[]
  quotations       Quotation[]
  purchaseOrders   PurchaseOrder[]
  sales            Sale[]
  productionOrders ProductionOrder[]

  @@unique([companyId, code])
  @@index([companyId])
  @@map("warehouses")
}

model Inventory {
  id          String    @id @default(cuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  quantity    Decimal   @default(0) @db.Decimal(18, 4)
  averageCost Decimal   @default(0) @db.Decimal(18, 4)

  /// Quantidade bloqueada para venda (não é reserva nem avaria — só
  /// impede a venda por decisão administrativa).
  blockedQuantity Decimal @default(0) @db.Decimal(18, 4)

  /// Quantidade reservada (comprometida com algo, ex.: um pedido).
  reservedQuantity Decimal @default(0) @db.Decimal(18, 4)

  /// Quantidade em quarentena (aguardando inspeção/liberação).
  quarantineQuantity Decimal @default(0) @db.Decimal(18, 4)

  /// Quantidade avariada (danificada, não vendável).
  damagedQuantity Decimal @default(0) @db.Decimal(18, 4)

  active            Boolean          @default(true)
  movements         StockMovement[]
  holds             StockHold[]
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  ProductCategory   ProductCategory? @relation(fields: [productCategoryId], references: [id])
  productCategoryId String?

  @@unique([companyId, productId, warehouseId])
  @@index([companyId])
  @@index([productId])
  @@index([warehouseId])
  @@map("inventories")
}

enum StockHoldType {
  BLOCKED
  RESERVED
  QUARANTINE
  DAMAGED
}

enum StockHoldStatus {
  ACTIVE
  RELEASED
}

/// Retenção de estoque: separa parte do saldo físico do que está
/// disponível para venda (bloqueio, reserva, quarentena ou avaria).
/// A soma das retenções ativas por tipo é espelhada nos campos
/// `blockedQuantity`/`reservedQuantity`/`quarantineQuantity`/
/// `damagedQuantity` do Inventory, para leitura rápida; este model é
/// o histórico/auditoria de cada retenção e sua liberação.
model StockHold {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  type   StockHoldType
  status StockHoldStatus @default(ACTIVE)

  quantity Decimal @db.Decimal(18, 4)
  reason   String? @db.VarChar(255)

  releasedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([inventoryId])
  @@index([type, status])
  @@map("stock_holds")
}

model StockMovement {
  id          String            @id @default(cuid())
  companyId   String
  company     Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory         @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 4)
  unitCost    Decimal?          @db.Decimal(18, 4)
  observation String?           @db.VarChar(255)

  /// Documento que originou a movimentação: número da compra/venda
  /// (ex.: C000000005/V000000007) nas automáticas, ou o que o
  /// usuário informou (ex.: "Nota Fiscal nº 55501") nas manuais.
  documentNumber String? @db.VarChar(100)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([inventoryId])
  @@map("stock_movements")
}

enum PurchaseStatus {
  DRAFT
  APPROVED
  RECEIVED
  CANCELLED
}

enum SaleStatus {
  DRAFT
  APPROVED
  INVOICED
  SHIPPED
  CANCELLED
}

model Purchase {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  /// Formatada no frontend como "C" + 9 dígitos (ex.: C000000001).
  number Int

  partnerId    String
  partner      BusinessPartner @relation("PurchasePartner", fields: [partnerId], references: [id])
  warehouseId  String
  warehouse    Warehouse       @relation(fields: [warehouseId], references: [id])
  status       PurchaseStatus  @default(DRAFT)
  purchaseDate DateTime?
  observation  String?
  totalAmount  Decimal         @default(0) @db.Decimal(18, 2)

  /// Prazo em dias até o vencimento do título gerado no recebimento.
  termDays Int? @default(0)

  /// Vencimento calculado (purchaseDate + termDays), já ajustado para
  /// dia útil (nunca sábado ou domingo).
  dueDate DateTime?

  paymentMethod PaymentMethod?

  /// Dados fiscais informados no recebimento (nota fiscal do
  /// fornecedor) — repassados ao título gerado no financeiro.
  invoiceNumber    String?   @db.VarChar(50)
  invoiceKey       String?   @db.VarChar(50)
  invoiceIssueDate DateTime?

  items PurchaseItem[]

  financialEntries FinancialEntry[]

  /// Preenchido quando a compra nasceu de um pedido de compra.
  purchaseOrderId String?        @unique
  purchaseOrder   PurchaseOrder? @relation(fields: [purchaseOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id])
  quantity   Decimal  @db.Decimal(18, 3)
  unitPrice  Decimal  @db.Decimal(18, 2)
  totalPrice Decimal  @db.Decimal(18, 2)

  @@index([purchaseId])
  @@map("purchase_items")
}

enum QuotationStatus {
  DRAFT
  DECIDED
  CANCELLED
}

/// Cotação: compara até 3 propostas de fornecedores diferentes para
/// os mesmos itens. Ao escolher o vencedor, trava (DECIDED) — daí
/// pode virar um Pedido de Compra com os dados do fornecedor
/// escolhido.
model Quotation {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  number Int

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status QuotationStatus @default(DRAFT)

  quotationDate DateTime?
  observation   String?

  items          QuotationItem[]
  offers         QuotationOffer[]
  purchaseOrders PurchaseOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("quotations")
}

/// O que está sendo cotado — só produto e quantidade, sem preço
/// (o preço vem de cada QuotationOffer).
model QuotationItem {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId   String
  product     Product   @relation(fields: [productId], references: [id])
  quantity    Decimal   @db.Decimal(18, 3)

  @@index([quotationId])
  @@map("quotation_items")
}

/// Proposta de um fornecedor para a cotação (no máximo 3 por
/// cotação — validado na camada de serviço).
model QuotationOffer {
  id String @id @default(cuid())

  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  partnerId String
  partner   BusinessPartner @relation("QuotationOfferPartner", fields: [partnerId], references: [id])

  isWinner Boolean @default(false)

  termDays      Int?
  paymentMethod PaymentMethod?

  totalAmount Decimal @default(0) @db.Decimal(18, 2)

  items         QuotationOfferItem[]
  purchaseOrder PurchaseOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([quotationId, partnerId])
  @@index([quotationId])
  @@map("quotation_offers")
}

model QuotationOfferItem {
  id               String         @id @default(cuid())
  quotationOfferId String
  quotationOffer   QuotationOffer @relation(fields: [quotationOfferId], references: [id], onDelete: Cascade)
  productId        String
  product          Product        @relation(fields: [productId], references: [id])
  unitPrice        Decimal        @db.Decimal(18, 2)
  totalPrice       Decimal        @db.Decimal(18, 2)

  @@index([quotationOfferId])
  @@map("quotation_offer_items")
}

enum PurchaseOrderStatus {
  DRAFT
  CONVERTED
  CANCELLED
}

/// Pedido de compra: compromisso com o fornecedor antes de virar
/// Compra. Pode nascer do zero ou puxado do vencedor de uma
/// Cotação. Se convertido, vira uma Compra (Purchase.purchaseOrderId)
/// e o status passa a CONVERTED — a partir daí não pode mais ser
/// editado.
model PurchaseOrder {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  number Int

  partnerId String
  partner   BusinessPartner @relation("PurchaseOrderPartner", fields: [partnerId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status PurchaseOrderStatus @default(DRAFT)

  orderDate   DateTime?
  observation String?

  totalAmount Decimal @default(0) @db.Decimal(18, 2)

  items    PurchaseOrderItem[]
  purchase Purchase?

  /// Preenchido quando o pedido nasceu da proposta vencedora de uma
  /// cotação.
  quotationId String?
  quotation   Quotation? @relation(fields: [quotationId], references: [id])

  quotationOfferId String?         @unique
  quotationOffer   QuotationOffer? @relation(fields: [quotationOfferId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([quotationId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  productId       String
  product         Product       @relation(fields: [productId], references: [id])
  quantity        Decimal       @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 2)
  totalPrice      Decimal       @db.Decimal(18, 2)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model Sale {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  /// Formatada no frontend como "V" + 9 dígitos (ex.: V000000001).
  number Int

  partnerId   String
  partner     BusinessPartner @relation("SalePartner", fields: [partnerId], references: [id])
  warehouseId String
  warehouse   Warehouse       @relation(fields: [warehouseId], references: [id])

  status SaleStatus @default(DRAFT)

  saleDate DateTime?

  approvedAt  DateTime?
  invoicedAt  DateTime?
  shippedAt   DateTime?
  cancelledAt DateTime?

  invoiceNumber String? @db.VarChar(50)
  trackingCode  String? @db.VarChar(100)

  /// Dados fiscais informados na aprovação (nota fiscal da venda) —
  /// repassados ao título gerado no financeiro.
  invoiceKey       String?   @db.VarChar(50)
  invoiceIssueDate DateTime?

  observation String?

  discountValue Decimal @default(0) @db.Decimal(18, 2)
  freightValue  Decimal @default(0) @db.Decimal(18, 2)
  otherExpenses Decimal @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)

  /// Prazo em dias até o vencimento do título gerado na aprovação.
  termDays Int? @default(0)

  /// Vencimento calculado (saleDate + termDays), já ajustado para dia
  /// útil (nunca sábado ou domingo).
  dueDate DateTime?

  paymentMethod PaymentMethod?

  items SaleItem[]

  financialEntries FinancialEntry[]

  /// Preenchido quando a venda nasceu de um orçamento ou pedido de
  /// venda (só um dos dois, escolhido no cadastro da venda).
  quoteId      String?     @unique
  quote        Quote?      @relation(fields: [quoteId], references: [id])
  salesOrderId String?     @unique
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("sales")
}

model SaleItem {
  id         String  @id @default(cuid())
  saleId     String
  sale       Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(18, 3)
  unitPrice  Decimal @db.Decimal(18, 2)
  totalPrice Decimal @db.Decimal(18, 2)

  @@index([saleId])
  @@map("sale_items")
}

/// Contador de numeração sequencial por empresa e por tipo de
/// documento (ex.: QUOTE, SALES_ORDER). Incrementado atomicamente
/// (upsert com `increment`) para nunca repetir número, mesmo com
/// duas requisições simultâneas.
model DocumentSequence {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type       String @db.VarChar(30)
  lastNumber Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, type])
  @@map("document_sequences")
}

enum QuoteStatus {
  DRAFT
  APPROVED
  CONVERTED
  CANCELLED
}

/// Orçamento: proposta enviada ao cliente antes da venda. Aprovado
/// gera um Pedido de Venda sozinho (SalesOrder.quoteId) e o status
/// passa a APPROVED. Se aceito diretamente (sem passar por Pedido),
/// vira uma Venda (Sale.quoteId) e o status passa a CONVERTED — em
/// ambos os casos, a partir daí não pode mais ser editado.
model Quote {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  number Int

  partnerId String
  partner   BusinessPartner @relation("QuotePartner", fields: [partnerId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status QuoteStatus @default(DRAFT)

  quoteDate  DateTime?
  validUntil DateTime?

  observation String?

  discountValue Decimal @default(0) @db.Decimal(18, 2)
  freightValue  Decimal @default(0) @db.Decimal(18, 2)
  otherExpenses Decimal @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)

  items QuoteItem[]
  sale  Sale?

  /// Pedido de Venda gerado quando o orçamento é aprovado (ver
  /// SalesOrder.quoteId) — relação reversa, a FK vive no SalesOrder.
  salesOrder SalesOrder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("quotes")
}

model QuoteItem {
  id         String  @id @default(cuid())
  quoteId    String
  quote      Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  productId  String
  product    Product @relation(fields: [productId], references: [id])
  quantity   Decimal @db.Decimal(18, 3)
  unitPrice  Decimal @db.Decimal(18, 2)
  totalPrice Decimal @db.Decimal(18, 2)

  @@index([quoteId])
  @@map("quote_items")
}

enum SalesOrderStatus {
  DRAFT
  CONVERTED
  CANCELLED
}

/// Pedido de venda: compromisso firmado com o cliente antes de
/// virar Venda (diferente do orçamento, que é só uma proposta).
/// Se convertido, vira uma Venda (Sale.salesOrderId) e o status
/// passa a CONVERTED — a partir daí não pode mais ser editado.
model SalesOrder {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa, nunca repete (DocumentSequence).
  number Int

  partnerId String
  partner   BusinessPartner @relation("SalesOrderPartner", fields: [partnerId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  status SalesOrderStatus @default(DRAFT)

  orderDate DateTime?

  observation String?

  discountValue Decimal @default(0) @db.Decimal(18, 2)
  freightValue  Decimal @default(0) @db.Decimal(18, 2)
  otherExpenses Decimal @default(0) @db.Decimal(18, 2)
  totalAmount   Decimal @default(0) @db.Decimal(18, 2)
  netAmount     Decimal @default(0) @db.Decimal(18, 2)

  items SalesOrderItem[]
  sale  Sale?

  /// Preenchido quando o pedido nasceu da aprovação automática de um
  /// Orçamento (ver Quote.salesOrder) — não editável, só referência.
  quoteId String? @unique
  quote   Quote?  @relation(fields: [quoteId], references: [id])

  productionOrders ProductionOrder[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@map("sales_orders")
}

model SalesOrderItem {
  id           String     @id @default(cuid())
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product    @relation(fields: [productId], references: [id])
  quantity     Decimal    @db.Decimal(18, 3)
  unitPrice    Decimal    @db.Decimal(18, 2)
  totalPrice   Decimal    @db.Decimal(18, 2)

  @@index([salesOrderId])
  @@map("sales_order_items")
}

enum ChartOfAccountType {
  RECEITA
  DESPESA
}

model ChartOfAccountClassification {
  id        String           @id @default(cuid())
  companyId String
  company   Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String           @db.VarChar(120)
  active    Boolean          @default(true)
  accounts  ChartOfAccount[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("chart_of_account_classifications")
}

model ChartOfAccount {
  id               String                       @id @default(cuid())
  companyId        String
  company          Company                      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  code             String                       @db.VarChar(20)
  classificationId String
  classification   ChartOfAccountClassification @relation(fields: [classificationId], references: [id])
  description      String                       @db.VarChar(255)
  type             ChartOfAccountType           @default(DESPESA)
  parentId         String?
  parent           ChartOfAccount?              @relation("ChartOfAccountHierarchy", fields: [parentId], references: [id])
  children         ChartOfAccount[]             @relation("ChartOfAccountHierarchy")
  financialEntries FinancialEntry[]
  active           Boolean                      @default(true)
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
  @@index([classificationId])
  @@map("chart_of_accounts")
}

/// Título financeiro: uma conta a pagar (PAYABLE) ou a receber
/// (RECEIVABLE). Vem das abas FLUXO_PAGAR e FLUXO_RECEBER da planilha,
/// que têm a mesma estrutura — por isso um único model com `type`.
enum FinancialEntryType {
  RECEIVABLE
  PAYABLE
}

enum FinancialEntryStatus {
  OPEN
  PAID
  CANCELLED
}

/// Tipo do documento que originou o título (aba MANUTENCAO_VALIDAÇOES,
/// coluna "TIPO PAGTO").
enum FinancialDocumentType {
  BOLETO
  CARNE
  CUPOM_FISCAL
  NOTA_FISCAL
  RECIBO
  OUTRO
}

/// Como o título foi/será liquidado (coluna "FORMA PAGTO" da planilha).
enum PaymentMethod {
  DINHEIRO
  PIX
  BOLETO
  TRANSFERENCIA
  DEPOSITO
  DEBITO
  CREDITO
  CHEQUE
  DESCONTO_NF
  OUTRO
}

model FinancialEntry {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  type   FinancialEntryType
  status FinancialEntryStatus @default(OPEN)

  /// Cliente (a receber) ou fornecedor (a pagar) — XOR com
  /// `employeeId` (título de folha/13º/férias aponta pro colaborador
  /// em vez de um parceiro; nunca os dois preenchidos, reforçado por
  /// CHECK no banco e validação no service/DTO).
  partnerId  String?
  partner    BusinessPartner? @relation("FinancialEntryPartner", fields: [partnerId], references: [id])
  employeeId String?
  employee   Employee?        @relation(fields: [employeeId], references: [id])

  chartOfAccountId String?
  chartOfAccount   ChartOfAccount? @relation(fields: [chartOfAccountId], references: [id])

  /// Data de emissão / da compra.
  issueDate DateTime

  /// Prazo em dias — só informativo; o vencimento é o que vale.
  termDays Int?

  dueDate DateTime

  documentNumber String?                @db.VarChar(50)
  documentType   FinancialDocumentType?

  /// Chave de acesso da nota fiscal eletrônica (44 dígitos).
  documentKey String? @db.VarChar(50)

  amount     Decimal @db.Decimal(18, 2)
  paidAmount Decimal @default(0) @db.Decimal(18, 2)

  paymentDate   DateTime?
  paymentMethod PaymentMethod?

  observation String?

  /// Preenchidos quando o título nasce automaticamente de uma
  /// compra recebida ou de uma venda aprovada.
  purchaseId String?
  purchase   Purchase? @relation(fields: [purchaseId], references: [id], onDelete: SetNull)
  saleId     String?
  sale       Sale?     @relation(fields: [saleId], references: [id], onDelete: SetNull)

  /// Preenchido quando o título nasce da aprovação de uma folha de pagamento.
  payrollItemId String?      @unique
  payrollItem   PayrollItem? @relation(fields: [payrollItemId], references: [id], onDelete: SetNull)

  /// Preenchido quando o título nasce da aprovação de uma parcela de 13º salário.
  thirteenthSalaryItemId String?               @unique
  thirteenthSalaryItem   ThirteenthSalaryItem? @relation(fields: [thirteenthSalaryItemId], references: [id], onDelete: SetNull)

  /// Preenchido quando o título nasce da aprovação de um gozo de férias.
  vacationGrantId String?        @unique
  vacationGrant   VacationGrant? @relation(fields: [vacationGrantId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([partnerId])
  @@index([employeeId])
  @@index([type, status])
  @@index([dueDate])
  @@map("financial_entries")
}

enum PayrollTaxType {
  INSS
  IRRF
}

/// Conjunto de parâmetros fiscais vigente num período — INSS, IRRF,
/// FGTS e dedução por dependente mudam todo ano (às vezes no meio do
/// ano), então viram cadastro editável em vez de valor fixo no
/// código. Nova vigência = nova linha (nunca edita uma já usada) —
/// folha já fechada continua auditável com a tabela que valia então.
model PayrollTaxTable {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  validFrom DateTime
  /// null = vigência em aberto (a atual).
  validTo   DateTime?

  fgtsPercentage          Decimal @default(8.00) @db.Decimal(5, 2)
  dependentDeductionValue Decimal @db.Decimal(18, 2)

  /// Redutor adicional de IRRF (reforma da isenção até R$5.000,
  /// vigente 2026): pra base tributável entre `irrfReliefThreshold` e
  /// `irrfReliefPhaseOutEnd`, desconta
  /// `irrfReliefBase - (irrfReliefFactor × base)` do IRRF já
  /// calculado pela tabela. Abaixo do threshold, isento total. Acima
  /// do phase-out, sem redutor (só a tabela tradicional). Nulos =
  /// redutor não se aplica (tabelas anteriores a 2026).
  irrfReliefThreshold   Decimal? @db.Decimal(18, 2)
  irrfReliefPhaseOutEnd Decimal? @db.Decimal(18, 2)
  irrfReliefBase        Decimal? @db.Decimal(18, 6)
  irrfReliefFactor      Decimal? @db.Decimal(10, 6)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brackets PayrollTaxBracket[]

  @@index([companyId])
  @@map("payroll_tax_tables")
}

/// Faixa progressiva de INSS ou IRRF. Fórmula unificada:
/// imposto = base × rate − deduction (parcela a deduzir).
model PayrollTaxBracket {
  id                String          @id @default(cuid())
  payrollTaxTableId String
  payrollTaxTable   PayrollTaxTable @relation(fields: [payrollTaxTableId], references: [id], onDelete: Cascade)

  taxType PayrollTaxType
  order   Int

  minBase   Decimal  @db.Decimal(18, 2)
  /// null = sem teto (última faixa, ex.: IRRF acima de R$4.664,68).
  maxBase   Decimal? @db.Decimal(18, 2)
  rate      Decimal  @db.Decimal(5, 2)
  deduction Decimal  @db.Decimal(18, 2)

  @@index([payrollTaxTableId, taxType])
  @@map("payroll_tax_brackets")
}

/// Parâmetros configuráveis da folha (singleton por empresa) — o que
/// não é tabela fiscal, mas ainda pode variar por empresa/convenção.
model PayrollSettings {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Adicional de hora extra (%) — ex.: 50 = paga 150% do valor/hora.
  extraHourSurchargePercentage  Decimal @default(50.00) @db.Decimal(5, 2)
  /// % do salário base descontado como Vale Transporte (limitado ao
  /// custo real cadastrado no benefício, se menor).
  transportVoucherPercentage    Decimal @default(6.00) @db.Decimal(5, 2)
  /// 1 = parcela única de 13º; 2 = duas parcelas (padrão CLT).
  thirteenthDefaultInstallments Int     @default(2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payroll_settings")
}

enum PayrollStatus {
  DRAFT
  APPROVED
  CANCELLED
}

enum PayrollItemStatus {
  PENDING
  INCLUDED
  EXCLUDED
}

enum PayrollLineType {
  PROVENTO
  DESCONTO
}

/// Folha de pagamento de uma competência (mês/ano) — por empresa
/// (cada filial paga seus próprios colaboradores, diferente dos
/// cadastros de apoio que são de grupo).
model Payroll {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa (DocumentSequenceService, tipo "PAYROLL").
  number Int

  competenceYear  Int
  competenceMonth Int

  status PayrollStatus @default(DRAFT)

  /// Usado como data de emissão/vencimento dos títulos gerados na aprovação.
  paymentDate      DateTime?
  generatedAt      DateTime  @default(now())
  approvedAt       DateTime?
  approvedByUserId String?

  totalGross        Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions   Decimal @default(0) @db.Decimal(18, 2)
  totalNet          Decimal @default(0) @db.Decimal(18, 2)
  /// Informativo — FGTS é encargo do empregador, não desconta do líquido.
  totalEmployerFgts Decimal @default(0) @db.Decimal(18, 2)

  observation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items PayrollItem[]

  @@unique([companyId, competenceYear, competenceMonth])
  @@index([companyId])
  @@map("payrolls")
}

/// Um colaborador dentro de uma folha — snapshot de tudo no momento
/// da geração (nunca recalcula sozinho se o cadastro do colaborador
/// mudar depois).
model PayrollItem {
  id         String   @id @default(cuid())
  payrollId  String
  payroll    Payroll  @relation(fields: [payrollId], references: [id], onDelete: Cascade)
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  status PayrollItemStatus @default(PENDING)

  baseSalary      Decimal    @db.Decimal(18, 2)
  salaryType      SalaryType
  dependentsCount Int        @default(0)

  workedMinutes   Int     @default(0)
  expectedMinutes Int     @default(0)
  extraMinutes    Int     @default(0)
  extraAmount     Decimal @default(0) @db.Decimal(18, 2)

  unjustifiedAbsenceDays Int     @default(0)
  absenceDeductionAmount Decimal @default(0) @db.Decimal(18, 2)

  transportVoucherDeduction Decimal @default(0) @db.Decimal(18, 2)

  otherEarnings   Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal @default(0) @db.Decimal(18, 2)

  grossAmount Decimal @default(0) @db.Decimal(18, 2)

  inssBase   Decimal @default(0) @db.Decimal(18, 2)
  inssAmount Decimal @default(0) @db.Decimal(18, 2)
  irrfBase   Decimal @default(0) @db.Decimal(18, 2)
  irrfAmount Decimal @default(0) @db.Decimal(18, 2)

  netAmount          Decimal @default(0) @db.Decimal(18, 2)
  employerFgtsAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Título a pagar gerado na aprovação — relação reversa, a FK vive
  /// no FinancialEntry (mesmo padrão de Sale.quoteId/salesOrderId).
  financialEntry FinancialEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines PayrollItemLine[]

  @@unique([payrollId, employeeId])
  @@index([employeeId])
  @@map("payroll_items")
}

/// Linha do holerite (o que é impresso) — rastreabilidade rubrica a
/// rubrica, mesmo padrão header/item já usado em Sale/SaleItem.
model PayrollItemLine {
  id            String      @id @default(cuid())
  payrollItemId String
  payrollItem   PayrollItem @relation(fields: [payrollItemId], references: [id], onDelete: Cascade)

  type           PayrollLineType
  /// SALARIO_BASE, HORAS_EXTRAS, VALE_TRANSPORTE, INSS, IRRF, FALTA_INJUSTIFICADA, BENEFICIO...
  code           String          @db.VarChar(40)
  description    String          @db.VarChar(150)
  /// Ex.: "220h", "6%", "2 dias" — texto livre pro holerite mostrar a referência.
  referenceValue String?         @db.VarChar(50)
  amount         Decimal         @db.Decimal(18, 2)
  sortOrder      Int

  @@index([payrollItemId])
  @@map("payroll_item_lines")
}

/// 13º salário de um ano/parcela (1 ou 2) — mesmo padrão header/item
/// de `Payroll`, reaproveitando os enums de status (DRAFT/APPROVED/
/// CANCELLED e PENDING/INCLUDED/EXCLUDED têm o mesmo significado aqui).
/// 1ª parcela (paga até 30/11): sem desconto de INSS/IRRF. 2ª parcela
/// (paga até 20/12): INSS/IRRF incidem sobre o valor TOTAL do 13º
/// (tributação exclusiva, separada do salário do mês), descontados
/// inteiros na 2ª parcela.
model ThirteenthSalary {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa (DocumentSequenceService, tipo "THIRTEENTH_SALARY").
  number Int

  year        Int
  /// 1 = primeira parcela (sem desconto), 2 = segunda parcela (com INSS/IRRF sobre o total).
  installment Int

  status PayrollStatus @default(DRAFT)

  paymentDate      DateTime?
  generatedAt      DateTime  @default(now())
  approvedAt       DateTime?
  approvedByUserId String?

  totalGross        Decimal @default(0) @db.Decimal(18, 2)
  totalDeductions   Decimal @default(0) @db.Decimal(18, 2)
  totalNet          Decimal @default(0) @db.Decimal(18, 2)
  totalEmployerFgts Decimal @default(0) @db.Decimal(18, 2)

  observation String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items ThirteenthSalaryItem[]

  @@unique([companyId, year, installment])
  @@index([companyId])
  @@map("thirteenth_salaries")
}

/// Um colaborador dentro de um 13º — snapshot no momento da geração,
/// igual a `PayrollItem`.
model ThirteenthSalaryItem {
  id                 String           @id @default(cuid())
  thirteenthSalaryId String
  thirteenthSalary   ThirteenthSalary @relation(fields: [thirteenthSalaryId], references: [id], onDelete: Cascade)
  employeeId         String
  employee           Employee         @relation(fields: [employeeId], references: [id])

  status PayrollItemStatus @default(PENDING)

  baseSalary   Decimal @db.Decimal(18, 2)
  /// Avos — meses trabalhados no ano (considerando pelo menos 15 dias no mês de admissão).
  monthsWorked Int

  /// Valor bruto do 13º completo (baseSalary/12 × monthsWorked) — igual nas duas parcelas.
  grossAmount               Decimal @default(0) @db.Decimal(18, 2)
  /// Só na 2ª parcela: valor já pago na 1ª (abatido do líquido, sem duplicar).
  previousInstallmentAmount Decimal @default(0) @db.Decimal(18, 2)

  otherEarnings   Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal @default(0) @db.Decimal(18, 2)

  inssBase   Decimal @default(0) @db.Decimal(18, 2)
  inssAmount Decimal @default(0) @db.Decimal(18, 2)
  irrfBase   Decimal @default(0) @db.Decimal(18, 2)
  irrfAmount Decimal @default(0) @db.Decimal(18, 2)

  netAmount          Decimal @default(0) @db.Decimal(18, 2)
  employerFgtsAmount Decimal @default(0) @db.Decimal(18, 2)

  /// Título a pagar gerado na aprovação — relação reversa, a FK vive no FinancialEntry.
  financialEntry FinancialEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines ThirteenthSalaryItemLine[]

  @@unique([thirteenthSalaryId, employeeId])
  @@index([employeeId])
  @@map("thirteenth_salary_items")
}

/// Linha do recibo de 13º — mesmo padrão de `PayrollItemLine`.
model ThirteenthSalaryItemLine {
  id                     String               @id @default(cuid())
  thirteenthSalaryItemId String
  thirteenthSalaryItem   ThirteenthSalaryItem @relation(fields: [thirteenthSalaryItemId], references: [id], onDelete: Cascade)

  type           PayrollLineType
  code           String          @db.VarChar(40)
  description    String          @db.VarChar(150)
  referenceValue String?         @db.VarChar(50)
  amount         Decimal         @db.Decimal(18, 2)
  sortOrder      Int

  @@index([thirteenthSalaryItemId])
  @@map("thirteenth_salary_item_lines")
}

enum VacationPeriodStatus {
  OPEN
  CLOSED
}

/// Período aquisitivo de férias (12 meses) — criado sob demanda a
/// partir da admissão (1º período) ou do fim do período anterior
/// (seguintes). `totalDays` sempre 30 — proporcionalidade por excesso
/// de faltas (art. 130 CLT) fora de escopo, ver plano.
model VacationPeriod {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  startDate          DateTime
  endDate            DateTime
  /// Prazo legal pra conceder as férias deste período (endDate + 12 meses).
  concessiveDeadline DateTime

  totalDays Int @default(30)
  usedDays  Int @default(0)
  soldDays  Int @default(0)

  status VacationPeriodStatus @default(OPEN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grants VacationGrant[]

  @@unique([employeeId, startDate])
  @@index([companyId])
  @@index([employeeId])
  @@map("vacation_periods")
}

/// Um "gozo" de férias — documento por colaborador (sem lote/
/// competência, diferente de Payroll/ThirteenthSalary: férias são
/// concedidas individualmente, quando o colaborador tira). Reaproveita
/// PayrollStatus (DRAFT/APPROVED/CANCELLED).
model VacationGrant {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id])

  vacationPeriodId String
  vacationPeriod   VacationPeriod @relation(fields: [vacationPeriodId], references: [id])

  /// Numeração sequencial por empresa (DocumentSequenceService, tipo "VACATION").
  number Int

  status PayrollStatus @default(DRAFT)

  startDate  DateTime
  /// Dias efetivamente gozados (descanso).
  days       Int
  /// Dias vendidos como abono pecuniário (até 1/3 do período — 10 de 30).
  soldDays   Int      @default(0)
  endDate    DateTime
  returnDate DateTime

  baseSalary Decimal @db.Decimal(18, 2)

  vacationAmount            Decimal @default(0) @db.Decimal(18, 2)
  /// 1/3 constitucional sobre `vacationAmount`.
  constitutionalThirdAmount Decimal @default(0) @db.Decimal(18, 2)
  /// Abono pecuniário — isento de INSS/IRRF/FGTS.
  soldAmount                Decimal @default(0) @db.Decimal(18, 2)
  soldThirdAmount           Decimal @default(0) @db.Decimal(18, 2)

  otherEarnings   Decimal @default(0) @db.Decimal(18, 2)
  otherDeductions Decimal @default(0) @db.Decimal(18, 2)

  /// Base tributável = vacationAmount + constitutionalThirdAmount (abono não entra).
  grossAmount Decimal @default(0) @db.Decimal(18, 2)
  inssBase    Decimal @default(0) @db.Decimal(18, 2)
  inssAmount  Decimal @default(0) @db.Decimal(18, 2)
  irrfBase    Decimal @default(0) @db.Decimal(18, 2)
  irrfAmount  Decimal @default(0) @db.Decimal(18, 2)

  netAmount          Decimal @default(0) @db.Decimal(18, 2)
  /// FGTS incide só sobre vacationAmount+constitutionalThirdAmount, nunca sobre o abono.
  employerFgtsAmount Decimal @default(0) @db.Decimal(18, 2)

  approvedAt       DateTime?
  approvedByUserId String?
  observation      String?

  /// Título a pagar gerado na aprovação — relação reversa, a FK vive no FinancialEntry.
  financialEntry FinancialEntry?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lines VacationGrantLine[]

  @@index([companyId])
  @@index([employeeId])
  @@map("vacation_grants")
}

/// Linha do recibo de férias — mesmo padrão de `PayrollItemLine`.
model VacationGrantLine {
  id              String        @id @default(cuid())
  vacationGrantId String
  vacationGrant   VacationGrant @relation(fields: [vacationGrantId], references: [id], onDelete: Cascade)

  type           PayrollLineType
  code           String          @db.VarChar(40)
  description    String          @db.VarChar(150)
  referenceValue String?         @db.VarChar(50)
  amount         Decimal         @db.Decimal(18, 2)
  sortOrder      Int

  @@index([vacationGrantId])
  @@map("vacation_grant_lines")
}

enum BudgetType {
  RECEITA
  DESPESA
}

/// Orçado por mês (aba BUDGET da planilha original). O realizado não é
/// gravado aqui — é calculado a partir de FinancialEntry (mesma lógica
/// de FinancialEntriesService.getCashFlow, agrupado por mês/tipo).
model Budget {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  year  Int
  month Int
  type  BudgetType

  plannedAmount Decimal @db.Decimal(18, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, year, month, type])
  @@index([companyId])
  @@map("budgets")
}

model Module {
  id             String           @id @default(cuid())
  code           String           @unique @db.VarChar(50)
  name           String           @db.VarChar(150)
  description    String?          @db.VarChar(500)
  icon           String?          @db.VarChar(100)
  route          String?          @db.VarChar(150)
  sortOrder      Int              @default(0)
  active         Boolean          @default(true)
  /// Preço quando contratado avulso (add-on), fora de um plano — ex.: BRANDING.
  monthlyPrice   Decimal?         @db.Decimal(18, 2)
  yearlyPrice    Decimal?         @db.Decimal(18, 2)
  planModules    PlanModule[]
  companyModules CompanyModule[]
  licenseHistory LicenseHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("modules")
}

model Plan {
  id             String           @id @default(cuid())
  code           String           @unique @db.VarChar(50)
  name           String           @db.VarChar(150)
  description    String?          @db.VarChar(500)
  monthlyPrice   Decimal?         @db.Decimal(18, 2)
  yearlyPrice    Decimal?         @db.Decimal(18, 2)
  /// Cobrança única no início (migração/treinamento) — não é mensalidade.
  setupFee       Decimal?         @db.Decimal(18, 2)
  maxUsers       Int?
  /// Ordem de exibição na página de preços (menor primeiro).
  sortOrder      Int              @default(0)
  /// Marca o plano "recomendado" com destaque visual na página de preços.
  highlighted    Boolean          @default(false)
  active         Boolean          @default(true)
  planModules    PlanModule[]
  companyPlans   CompanyPlan[]
  licenseHistory LicenseHistory[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@map("plans")
}

model PlanModule {
  id        String   @id @default(cuid())
  planId    String
  moduleId  String
  included  Boolean  @default(true)
  createdAt DateTime @default(now())
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  module    Module   @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
  @@index([planId])
  @@index([moduleId])
  @@map("plan_modules")
}

enum CompanyPlanStatus {
  /// Período de teste, ainda não pagou.
  TRIAL
  /// Assinatura em dia.
  ACTIVE
  /// Venceu e não pagou ainda, mas dentro da tolerância — módulos continuam liberados.
  PAST_DUE
  /// Tolerância vencida — módulos básicos (login, licenciamento) continuam liberados, o resto não.
  BLOCKED
  /// Cancelada pelo cliente ou pela plataforma.
  CANCELLED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

model CompanyPlan {
  id          String    @id @default(cuid())
  companyId   String    @unique
  planId      String
  startDate   DateTime  @default(now())
  endDate     DateTime?
  trialEndsAt DateTime?
  active      Boolean   @default(true)
  autoRenew   Boolean   @default(true)
  company     Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Restrict)

  status           CompanyPlanStatus @default(TRIAL)
  billingCycle     BillingCycle      @default(MONTHLY)
  /// Até quando a assinatura está paga (fim do período corrente).
  currentPeriodEnd DateTime?
  /// Prazo de tolerância após vencer — só é preenchido quando cai em PAST_DUE.
  graceUntil       DateTime?

  asaasCustomerId     String? @db.VarChar(50)
  asaasSubscriptionId String? @db.VarChar(50)

  charges BillingCharge[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([planId])
  @@index([status])
  @@map("company_plans")
}

enum BillingChargeType {
  SUBSCRIPTION
  SETUP_FEE
  ADDON
}

enum BillingChargeStatus {
  PENDING
  CONFIRMED
  RECEIVED
  OVERDUE
  REFUNDED
  CANCELLED
}

/// Cada cobrança emitida no Asaas — histórico de faturas/PIX/boletos
/// gerados pra assinatura, pra mostrar ao cliente (link, status) e pra
/// reconciliar com o webhook.
model BillingCharge {
  id            String      @id @default(cuid())
  companyPlanId String
  companyPlan   CompanyPlan @relation(fields: [companyPlanId], references: [id], onDelete: Cascade)

  asaasPaymentId String? @unique @db.VarChar(50)

  type        BillingChargeType
  billingType String?             @db.VarChar(20)
  value       Decimal             @db.Decimal(18, 2)
  dueDate     DateTime
  status      BillingChargeStatus @default(PENDING)
  paidAt      DateTime?

  invoiceUrl  String? @db.VarChar(255)
  bankSlipUrl String? @db.VarChar(255)
  pixPayload  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyPlanId])
  @@map("billing_charges")
}

/// Log de todo evento de webhook recebido do Asaas, pra idempotência —
/// o Asaas reenvia eventos, e sem isso um PAYMENT_CONFIRMED duplicado
/// estenderia a assinatura duas vezes.
model BillingWebhookEvent {
  id           String   @id @default(cuid())
  asaasEventId String   @unique @db.VarChar(100)
  event        String   @db.VarChar(50)
  payload      Json
  processedAt  DateTime @default(now())

  @@map("billing_webhook_events")
}

model CompanyModule {
  id            String    @id @default(cuid())
  companyId     String
  moduleId      String
  enabled       Boolean   @default(true)
  licensed      Boolean   @default(true)
  trial         Boolean   @default(false)
  trialStartsAt DateTime?
  trialEndsAt   DateTime?
  activatedAt   DateTime?
  expiresAt     DateTime?
  company       Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module        Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([companyId, moduleId])
  @@index([companyId])
  @@index([moduleId])
  @@map("company_modules")
}

model LicenseHistory {
  id          String   @id @default(cuid())
  companyId   String
  moduleId    String?
  planId      String?
  event       String   @db.VarChar(50)
  description String?  @db.VarChar(500)
  createdBy   String?
  metadata    Json?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  module      Module?  @relation(fields: [moduleId], references: [id], onDelete: SetNull)
  plan        Plan?    @relation(fields: [planId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([companyId])
  @@index([moduleId])
  @@index([planId])
  @@map("license_history")
}

// ============================================================
// RH (Recursos Humanos) — módulo add-on licenciável
// ============================================================

/// Tabela oficial de ocupações (CBO 2002 — Classificação Brasileira de
/// Ocupações), catálogo global, não é por empresa. Só leitura: usada como
/// busca/autocomplete no campo CBO de Função. Fonte: dataset público
/// (Ministério do Trabalho), importado via prisma/data/cbo.csv.
model CboOccupation {
  code  String @id @db.VarChar(10)
  title String @db.VarChar(200)

  @@index([title])
  @@map("cbo_occupations")
}

model Sector {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(120)
  description  String?       @db.VarChar(255)
  active       Boolean       @default(true)
  jobFunctions JobFunction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("sectors")
}

/// Cadastro de horários de trabalho (ex.: "Comercial (Seg a Sex)" —
/// "SEG A SEX: 07:30-12:00 | 13:12-17:30"), reaproveitável entre funções.
model WorkSchedule {
  id           String              @id @default(cuid())
  companyId    String
  company      Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String              @db.VarChar(120)
  description  String?             @db.VarChar(255)
  active       Boolean             @default(true)
  jobFunctions JobFunction[]
  employees    Employee[]
  shifts       WorkScheduleShift[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("work_schedules")
}

enum Weekday {
  SEGUNDA
  TERCA
  QUARTA
  QUINTA
  SEXTA
  SABADO
  DOMINGO
}

/// Faixa de dias + horários dentro de um Horário de trabalho, usada
/// pro cálculo de horas normais/extras no Controle de Ponto. Um
/// mesmo horário pode ter mais de uma faixa (ex.: SEG a SEX um
/// horário, SÁBADO outro sem intervalo) — cada dia da semana deve
/// cair em no máximo uma faixa.
model WorkScheduleShift {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  workScheduleId String
  workSchedule   WorkSchedule @relation(fields: [workScheduleId], references: [id], onDelete: Cascade)

  dayFrom Weekday
  dayTo   Weekday

  /// Horários no formato "HH:MM".
  startTime  String  @db.VarChar(5)
  breakStart String? @db.VarChar(5)
  breakEnd   String? @db.VarChar(5)
  endTime    String  @db.VarChar(5)

  /// Minutos de intervalo usados no cálculo quando breakStart/breakEnd
  /// não são informados (só duração, sem horário de relógio).
  lunchBreakMinutes Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([workScheduleId])
  @@map("work_schedule_shifts")
}

/// Cadastro de tipos de EPI (equipamento de proteção individual) —
/// entrega/ficha por colaborador fica para o módulo de EPI (sprint
/// seguinte); aqui é só o catálogo, vinculável às funções que exigem uso.
model PpeType {
  id           String        @id @default(cuid())
  companyId    String
  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name         String        @db.VarChar(120)
  description  String?       @db.VarChar(255)
  active       Boolean       @default(true)
  jobFunctions JobFunction[]
  deliveries   PpeDelivery[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@map("ppe_types")
}

enum SalaryType {
  MENSALISTA
  HORISTA
  DIARISTA
  COMISSIONADO
  OUTRO
}

model JobFunction {
  id          String  @id @default(cuid())
  companyId   String
  company     Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String  @db.VarChar(150)
  description String? @db.VarChar(255)

  /// Código CBO (ex.: "2521-05") — referência livre à CboOccupation, sem
  /// FK (a tabela é global e não precisa travar a integridade aqui).
  cboCode  String? @db.VarChar(10)
  cboTitle String? @db.VarChar(200)

  sectorId String?
  sector   Sector? @relation(fields: [sectorId], references: [id])

  baseSalary Decimal?    @db.Decimal(18, 2)
  salaryType SalaryType?

  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])

  /// Se a função exige uso de EPI. Os EPIs específicos ficam em `ppeTypes`.
  requiresPpe Boolean   @default(false)
  ppeTypes    PpeType[]

  employees Employee[]

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, name])
  @@index([companyId])
  @@index([sectorId])
  @@index([workScheduleId])
  @@map("job_functions")
}

enum Gender {
  MASCULINO
  FEMININO
  OUTRO
}

enum MaritalStatus {
  SOLTEIRO
  CASADO
  DIVORCIADO
  VIUVO
  UNIAO_ESTAVEL
  OUTRO
}

enum EducationLevel {
  FUNDAMENTAL_INCOMPLETO
  FUNDAMENTAL_COMPLETO
  MEDIO_INCOMPLETO
  MEDIO_COMPLETO
  SUPERIOR_INCOMPLETO
  SUPERIOR_COMPLETO
  POS_GRADUACAO
  MESTRADO
  DOUTORADO
}

enum EmployeeStatus {
  EXPERIENCIA
  ATIVO
  AFASTADO
  DEMITIDO
}

enum DependentRelationship {
  FILHO
  CONJUGE
  PAI
  MAE
  OUTRO
}

/// Colaborador (aba CAD_COLABORADOR da planilha original — 68 campos).
/// Campos agrupados abaixo pelas mesmas seções da tela (não um
/// formulário único): Pessoais, Documentos, Contato, Contratuais,
/// Saúde ocupacional, Benefícios. Dependentes é tabela filha.
model Employee {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Matrícula sequencial gerada sozinha por empresa (DocumentSequenceService,
  /// type "EMPLOYEE") — nunca editável pelo usuário.
  employeeNumber Int?

  // --- Pessoais ---
  name           String          @db.VarChar(150)
  fatherName     String?         @db.VarChar(150)
  motherName     String?         @db.VarChar(150)
  birthDate      DateTime?
  gender         Gender?
  birthCity      String?         @db.VarChar(100)
  birthState     String?         @db.VarChar(2)
  maritalStatus  MaritalStatus?
  educationLevel EducationLevel?

  /// Foto do colaborador (frente "Interprise" — cadastro de grupo).
  photo String? @db.VarChar(255)

  // --- Documentos ---
  cpf            String? @db.VarChar(14)
  rg             String? @db.VarChar(20)
  workCard       String? @db.VarChar(20)
  workCardSeries String? @db.VarChar(20)
  pis            String? @db.VarChar(20)

  /// Categorias marcadas em caixa de seleção (ex.: "AB"), sem
  /// separador — concatenação simples das letras A a E.
  driverLicense         String? @db.VarChar(20)
  driverLicenseCategory String? @db.VarChar(10)

  // --- Contato ---
  zipCode  String? @db.VarChar(10)
  street   String? @db.VarChar(200)
  number   String? @db.VarChar(20)
  district String? @db.VarChar(100)
  city     String? @db.VarChar(100)
  state    String? @db.VarChar(2)
  phone    String? @db.VarChar(20)
  mobile   String? @db.VarChar(20)
  email    String? @db.VarChar(150)

  /// Usuário de login vinculado a este colaborador (autoatendimento —
  /// ex.: Ponto - Manual). Opcional, um usuário só pode estar
  /// vinculado a um colaborador por vez (`@unique`).
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  // --- Contratuais ---
  jobFunctionId String?
  jobFunction   JobFunction? @relation(fields: [jobFunctionId], references: [id])

  workScheduleId String?
  workSchedule   WorkSchedule? @relation(fields: [workScheduleId], references: [id])

  baseSalary    Decimal?       @db.Decimal(18, 2)
  salaryType    SalaryType?
  paymentMethod PaymentMethod?

  admissionDate       DateTime?
  /// Estágio atual do período de experiência: 30, 60 ou 90 dias.
  /// Avança sozinho (30→60→90) conforme o prazo vence — ver
  /// EmployeesService.reconcileExperience. Ao passar de 90, status
  /// vira ATIVO (efetivado) automaticamente.
  experienceStageDays Int?           @default(30)
  experienceEndDate   DateTime?
  contractEndDate     DateTime?
  terminationDate     DateTime?
  status              EmployeeStatus @default(EXPERIENCIA)

  /// Código/crachá pra bater ponto (módulo LABOR) — o que vai
  /// codificado no QR/código de barras do colaborador. Único por
  /// empresa quando preenchido; sem ele, ainda dá pra bater ponto
  /// usando o id interno do colaborador.
  badgeCode String? @db.VarChar(30)

  // --- Saúde ocupacional ---
  /// Data do próximo exame pendente — denormalizado a partir do
  /// último EmployeeExam (ou da admissão, se nunca houve exame).
  nextExamDate DateTime?
  noticeDays   Int?
  onLeave      Boolean   @default(false)

  /// Quantos dias antes do próximo exame o colaborador recebe o
  /// primeiro aviso por e-mail/WhatsApp (ScheduledNotificationsService).
  /// Sempre recebe também um aviso fixo 3 dias antes e no próprio dia,
  /// independente deste valor.
  examReminderDays Int? @default(7)

  /// Fim do afastamento é sempre calculado no backend (início + dias),
  /// igual ao vencimento da experiência. Preencher o início marca
  /// onLeave automaticamente.
  leaveStartDate DateTime?
  leaveDays      Int?
  leaveEndDate   DateTime?

  /// Mesmo padrão do afastamento, para férias.
  vacationStartDate DateTime?
  vacationDays      Int?
  vacationEndDate   DateTime?
  onVacation        Boolean   @default(false)

  // --- Dados bancários (pagamento de salário) ---
  bankName        String?          @db.VarChar(100)
  bankAgency      String?          @db.VarChar(20)
  bankAccount     String?          @db.VarChar(20)
  bankAccountType BankAccountType?
  pixKeyType      PixKeyType?
  pixKey          String?          @db.VarChar(150)

  // --- Benefícios (catálogo dinâmico, ver model Benefit) ---
  lockerKey    String? @db.VarChar(20)
  lockerNumber String? @db.VarChar(20)

  /// Tamanhos de calçado/vestuário — usados na entrega de EPI.
  shoeSize  String? @db.VarChar(10)
  shirtSize String? @db.VarChar(10)
  pantsSize String? @db.VarChar(10)

  observation String? @db.VarChar(500)

  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  dependents            EmployeeDependent[]
  ppeDeliveries         PpeDelivery[]
  employeeBenefits      EmployeeBenefit[]
  exams                 EmployeeExam[]
  timeEntries           TimeEntry[]
  timeSheetApprovals    TimeSheetApproval[]
  timeEntryAdjustments  TimeEntryAdjustment[]
  absenceRecords        AbsenceRecord[]
  financialEntries      FinancialEntry[]
  payrollItems          PayrollItem[]
  thirteenthSalaryItems ThirteenthSalaryItem[]
  vacationPeriods       VacationPeriod[]
  vacationGrants        VacationGrant[]

  @@unique([companyId, cpf])
  @@unique([companyId, badgeCode])
  @@unique([companyId, employeeNumber])
  @@index([companyId])
  @@index([jobFunctionId])
  @@map("employees")
}

enum ExamStatus {
  NO_PRAZO
  ATRASADO
}

enum BankAccountType {
  CORRENTE
  POUPANCA
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  TELEFONE
  ALEATORIA
}

/// Histórico de exames ocupacionais realizados. Cada registro é a
/// data em que um exame de fato aconteceu — o próximo exame
/// (examDate + 1 ano, dia útil) e o status (a tempo/atrasado, contra
/// o prazo anterior — ou a admissão, se for o primeiro exame) são
/// calculados na hora de gravar. Ver EmployeeExamsService.
model EmployeeExam {
  id           String     @id @default(cuid())
  employeeId   String
  employee     Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  examDate     DateTime
  nextExamDate DateTime
  status       ExamStatus
  createdAt    DateTime   @default(now())

  @@index([employeeId])
  @@map("employee_exams")
}

enum BenefitCalculationType {
  FIXED
  PERCENTAGE
}

/// Catálogo de benefícios da empresa (Vale Transporte, Vale Refeição,
/// Vale Alimentação, etc.) — manutenção própria (criar/editar/
/// desativar), igual padrão de Setor/Horário/Tipo de EPI.
model Benefit {
  id                 String                 @id @default(cuid())
  companyId          String
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name               String                 @db.VarChar(120)
  description        String?                @db.VarChar(255)
  /// FIXED: valor em R$ digitado direto. PERCENTAGE: % sobre o
  /// salário do colaborador (ex.: Vale Transporte).
  calculationType    BenefitCalculationType @default(FIXED)
  /// Marca o benefício de Vale Transporte pra folha descontar os 6%
  /// (ou o custo real, se cadastrado menor) automaticamente — em vez
  /// de tentar reconhecer pelo nome digitado.
  isTransportVoucher Boolean                @default(false)
  active             Boolean                @default(true)
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  employeeBenefits EmployeeBenefit[]

  @@unique([companyId, name])
  @@index([companyId])
  @@map("benefits")
}

/// Benefício concedido a um colaborador. Se o benefício for FIXED,
/// `value` é o valor em R$ digitado. Se for PERCENTAGE, `percentage`
/// é o % digitado e o valor em R$ é calculado a partir do salário
/// atual do colaborador (nunca gravado, pra não ficar desatualizado
/// se o salário mudar).
model EmployeeBenefit {
  id         String   @id @default(cuid())
  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  benefitId  String
  benefit    Benefit  @relation(fields: [benefitId], references: [id])
  value      Decimal? @db.Decimal(18, 2)
  percentage Decimal? @db.Decimal(5, 2)
  createdAt  DateTime @default(now())

  @@unique([employeeId, benefitId])
  @@index([employeeId])
  @@map("employee_benefits")
}

model EmployeeDependent {
  id           String                 @id @default(cuid())
  employeeId   String
  employee     Employee               @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  name         String                 @db.VarChar(150)
  birthDate    DateTime?
  relationship DependentRelationship?
  /// Se entra na dedução de IRRF da folha (R$189,59/mês em 2026) —
  /// desmarcar quando o dependente passar da idade/condição que dá
  /// direito, sem precisar excluir o cadastro.
  irrfEligible Boolean                @default(true)
  createdAt    DateTime               @default(now())

  @@index([employeeId])
  @@map("employee_dependents")
}

/// Entrega de EPI a um colaborador (aba FICHA_EPI da planilha
/// original — declaração de recebimento conforme NR-6/Portaria
/// 3214/78). Cada linha vira uma linha da ficha impressa
/// (Data/Especificação/CA/Qtde/Assinatura).
model PpeDelivery {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  ppeTypeId String
  ppeType   PpeType @relation(fields: [ppeTypeId], references: [id])

  /// Certificado de Aprovação do EPI entregue nesta remessa
  /// (varia por lote/fabricante, por isso fica na entrega e não
  /// no cadastro do tipo de EPI).
  ca String? @db.VarChar(20)

  quantity     Decimal  @default(1) @db.Decimal(10, 2)
  deliveryDate DateTime @default(now())
  observation  String?  @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([employeeId])
  @@map("ppe_deliveries")
}

/// Etapas em sequência: aguardando -> em produção -> finalizada.
/// Cancelada é terminal, só a partir de aguardando/em produção.
enum ProductionOrderStatus {
  AGUARDANDO_PRODUCAO
  EM_PRODUCAO
  FINALIZADA
  CANCELADA
}

/// Motivo que gerou a ordem — MANUAL é criada na mão, as outras duas
/// nascem sozinhas (ver ProductionOrdersService.autoGenerate*).
enum ProductionOrderOrigin {
  MANUAL
  SALES_ORDER
  LOW_STOCK
}

/// Ordem de produção — módulo licenciável opcional (PRODUCTION),
/// genérico (não específico de confecção, apesar da planilha
/// original ser de uma fábrica de costura). Nasce manual ou
/// automaticamente: pedido de venda com quantidade maior que o saldo
/// disponível, ou saldo de um produto chegando ao mínimo cadastrado
/// (ver ProductionOrdersService).
model ProductionOrder {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Numeração sequencial por empresa (DocumentSequence, tipo PRODUCTION_ORDER).
  number Int

  productId String
  product   Product @relation(fields: [productId], references: [id])

  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id])

  quantity Decimal @db.Decimal(18, 3)

  origin ProductionOrderOrigin @default(MANUAL)

  /// Só preenchido quando origin = SALES_ORDER.
  salesOrderId String?
  salesOrder   SalesOrder? @relation(fields: [salesOrderId], references: [id])

  status ProductionOrderStatus @default(AGUARDANDO_PRODUCAO)

  /// Data de abertura da ordem — sempre o dia em que foi criada, não
  /// editável (distinta de `createdAt`, que é o timestamp técnico).
  orderDate DateTime

  /// Quantos dias a produção deve levar — junto com `orderDate`,
  /// calcula `expectedDate` (previsão) automaticamente.
  productionDays Int

  /// Previsão de entrega = orderDate + productionDays, sempre
  /// recalculada no backend (nunca aceita direto do formulário).
  expectedDate DateTime

  /// Preenchido ao concluir (informado pelo usuário, não é sempre
  /// "agora" — pode ser uma data passada) — junto disso, gera entrada
  /// de estoque da quantidade produzida (ver ProductionOrdersService.complete).
  completedAt DateTime?

  /// Observação da conclusão (data + observação, pedidas juntas na
  /// hora de concluir) — separada da observação geral da ordem.
  completionObservation String? @db.VarChar(500)

  observation String? @db.VarChar(500)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, number])
  @@index([companyId])
  @@index([productId])
  @@map("production_orders")
}

/// Configuração de produção por empresa — um registro só (upsert).
model ProductionSettings {
  id String @id @default(cuid())

  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  /// Lote mínimo padrão de uma ordem de produção gerada automaticamente
  /// — evita ordem de 1 unidade por causa de uma venda pequena.
  /// Product.minProductionBatch sobrepõe este valor quando preenchido.
  minBatchSize Decimal @default(1) @db.Decimal(18, 3)

  /// Dias de produção padrão usados quando uma ordem nasce sozinha
  /// (o gatilho não tem como saber quanto tempo aquele produto leva).
  defaultProductionDays Int @default(7)

  /// Gerar ordem de produção sozinha quando um pedido de venda pedir
  /// mais do que o saldo disponível no almoxarifado do pedido.
  autoGenerateOnSalesOrder Boolean @default(true)

  /// Gerar ordem de produção sozinha quando o saldo de um produto
  /// chegar ao mínimo cadastrado (Product.minimumStock).
  autoGenerateOnLowStock Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("production_settings")
}

enum TimeEntrySource {
  MANUAL
  API
  BARCODE
  QRCODE
  AJUSTE
  AUTOLANCAMENTO
}

/// Registro bruto de ponto (uma batida). O dia trabalhado é calculado
/// juntando as batidas de um mesmo colaborador+data em pares
/// entrada/saída — ver TimeTrackingService.getDaySummary.
model TimeEntry {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  timestamp DateTime

  source TimeEntrySource @default(MANUAL)

  observation String? @db.VarChar(255)

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([employeeId, timestamp])
  @@map("time_entries")
}

/// Aprovação do dia trabalhado — um registro por colaborador+data.
/// Sem registro aqui, o dia é considerado pendente. `workedMinutes` é
/// um retrato do total calculado no momento da aprovação (não
/// recalcula sozinho se novas batidas daquele dia aparecerem depois).
model TimeSheetApproval {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Só a data (meia-noite UTC), sem hora — mesmo padrão de outras
  /// datas "de calendário" no sistema.
  date DateTime

  workedMinutes Int

  approvedByUserId String?

  createdAt DateTime @default(now())

  @@unique([companyId, employeeId, date])
  @@index([companyId])
  @@map("time_sheet_approvals")
}

/// Auditoria de ajuste manual de ponto (botão "Ajustar" na tela de
/// Controle de Ponto) — grava o antes/depois dos 4 horários do dia
/// (Início/Início Intervalo/Fim Intervalo/Saída) e a justificativa,
/// pra dar pra consultar depois quem alterou, quando e por quê.
model TimeEntryAdjustment {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  /// Só a data (meia-noite UTC) do dia ajustado.
  date DateTime

  beforeStart      DateTime?
  beforeBreakStart DateTime?
  beforeBreakEnd   DateTime?
  beforeEnd        DateTime?

  afterStart      DateTime?
  afterBreakStart DateTime?
  afterBreakEnd   DateTime?
  afterEnd        DateTime?

  justification String @db.VarChar(500)

  adjustedByUserId String

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([employeeId, date])
  @@map("time_entry_adjustments")
}

enum AbsenceType {
  FALTA_JUSTIFICADA
  FALTA_INJUSTIFICADA
  ABONO
}

enum AbsenceStatus {
  PENDENTE
  APROVADO
  REJEITADO
}

/// Falta (justificada/injustificada) ou abono, com aprovação —
/// mesma regra Editar/Cancelar/Estornar: Editar só Pendente,
/// Aprovar/Rejeitar decide, e dá pra reabrir (volta pra Pendente).
model AbsenceRecord {
  id String @id @default(cuid())

  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  employeeId String
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  date DateTime

  type AbsenceType

  reason String? @db.VarChar(500)

  status AbsenceStatus @default(PENDENTE)

  approvedByUserId String?
  approvedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([employeeId, date])
  @@map("absence_records")
}
